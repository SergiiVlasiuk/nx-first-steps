{
  "name": "@my-nx-ws/source",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "echo:biome-inactive": " =========================== echo !!!Configure experimental formatter commands =========================== ",
    "lint:biome": "biome lint .",
    "format:biome": "biome format . --write",
    "format:biome:check": "biome format . --diagnostic-level=warn",
    "echo:lint:eslint:config": " =========================== echo \"!!!Using eslint-config-prettier\" =========================== ",
    "lint:eslint:config:check": "eslint --print-config . > .eslintrc.json",
    "lint:eslint": "eslint \"apps/**/*.ts\" \"libs/**/*.ts\" --ext .ts,.tsx",
    "lint:eslint:fix": "eslint \"apps/**/*.ts\" \"libs/**/*.ts\" --ext .ts,.tsx --fix",
    "format:prettier": "biome format . --write",
    "format:prettier:check": "biome format . --diagnostic-level=warn",
    "echo:nx:all": " =========================== echo !!!Using nx run-many =========================== ",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "format": "nx format",
    "format:check": "nx format:check",
    "format:fix": "nx format:write",
    "check": "yarn lint && yarn test && yarn format",
    "clean": "nx run-many --target=clean --all"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "20.7.1",
    "@nx/eslint-plugin": "20.7.1",
    "@nx/js": "20.7.1",
    "@nx/vite": "^20.7.1",
    "@nx/web": "20.7.1",
    "@solidjs/testing-library": "^0.8.10",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "18.16.9",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsonc": "^2.20.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.4.0",
    "nx": "20.7.1",
    "prettier": "^2.6.2",
    "swc-loader": "0.1.15",
    "tslib": "^2.3.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "^3.0.0",
    "vitest-dom": "^0.1.1"
  },
  "workspaces": [
    "packages/*",
    "libs/*",
    "apps/my-app1",
    "apps/my-app2"
  ]
}
