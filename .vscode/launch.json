{
    "version": "0.2.0",
    "configurations": [
      {
        // "type": "pwa-node",
        "type": "node",
        "request": "launch",
        "name": "Vitest: Debug my-app2 tests",
        "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
        "args": [
          "run",
          "--config",
        //   "apps/my-app2/vitest.config.ts",
          "apps/my-app2/vite.config.ts",
          "--inspect"
        ],
        "autoAttachChildProcesses": true,
        "cwd": "${workspaceFolder}",
        "smartStep": true,
        "skipFiles": ["<node_internals>/**", "node_modules/**"]
      }
    ]
  }
  
